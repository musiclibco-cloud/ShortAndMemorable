                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)

            sliderBtn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            table.insert(connections, RS.Heartbeat:Connect(function()
                if dragging then
                    local mousePos = UIS:GetMouseLocation()
                    local relPos = math.clamp((mousePos.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
                    value = math.floor(min + (max - min) * relPos + 0.5)
                    fill.Size = UDim2.new(relPos, 0, 1, 0)
                    sliderLabel.Text = label .. ": " .. value
                    pcall(callback, value)
                end
            end))

