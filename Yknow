local function getSafeParent()
    local hui
    local success, err = pcall(function()
        hui = gethui and gethui() or nil
    end)
    if success and hui then return hui end
    local success2, coregui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if success2 and coregui then return coregui end
    if LocalPlayer then
        return LocalPlayer:WaitForChild("PlayerGui", 10) or game:GetService("CoreGui")
    end
    return game:GetService("CoreGui") -- Fallback
end

-- CreateWindow
function ForsakenLib:CreateWindow(title, options)
    options = options or {}
    for k, v in pairs(DefaultOptions) do
        if options[k] == nil then
            options[k] = v
        end
    end

    local theme = Themes[options.theme] or Themes.ClassicGray
    local mobilemode = options.mobilemode
    if mobilemode == nil then
        mobilemode = UIS.TouchEnabled and not UIS.KeyboardEnabled
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ForsakenLib_" .. title:gsub("%s", "")
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 1000000 -- High priority for executors
    screenGui.Parent = getSafeParent()

    local notifications = Instance.new("Frame")
    notifications.Name = "Notifications"
    notifications.Size = UDim2.new(0, 300, 1, 0)
    notifications.Position = UDim2.new(1, -310, 0, 0)
    notifications.BackgroundTransparency = 1
    notifications.Parent = screenGui

    local notifLayout = Instance.new("UIListLayout")
    notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.Padding = UDim.new(0, 10)
    notifLayout.Parent = notifications

    local connections = {}
    local tabs = {}
    local currentTab
    local visible = true
    local minimized = false
    local isOpen = true
    local isLarge = false
    local drawerWidth = 250

    local mainFrame = Instance.new("Frame")
    local topBar
    local sidebar
    local content = Instance.new("Frame")
    local minimizeButton
    local closeButton
    local resizeCorner
    local overlay

    if not mobilemode then
        -- Desktop mode
        mainFrame.Name = "Window"
        mainFrame.Size = UDim2.new(0, 600, 0, 400)
        mainFrame.Position = UDim2.new(0.5, -300, 0.5, -200)
        mainFrame.BackgroundColor3 = theme.Background
        mainFrame.BorderSizePixel = 0
        mainFrame.ClipsDescendants = true
        mainFrame.Parent = screenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = mainFrame

        local shadow = Instance.new("UIStroke")
        shadow.Transparency = 1 - theme.ShadowOpacity
        shadow.Color = theme.Shadow
        shadow.Thickness = 2
        shadow.Parent = mainFrame

        topBar = Instance.new("Frame")
        topBar.Name = "TopBar"
        topBar.Size = UDim2.new(1, 0, 0, 30)
        topBar.BackgroundColor3 = theme.Panel
        topBar.BorderSizePixel = 0
        topBar.Parent = mainFrame

        local topCorner = Instance.new("UICorner")
        topCorner.CornerRadius = UDim.new(0, 10)
        topCorner.Parent = topBar

        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(1, -60, 1, 0)
        titleLabel.Position = UDim2.new(0, 10, 0, 0)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Text = title
        titleLabel.TextColor3 = theme.Text
        titleLabel.Font = theme.Font
        titleLabel.TextSize = 18
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.Parent = topBar

        minimizeButton = Instance.new("TextButton")
        minimizeButton.Size = UDim2.new(0, 30, 1, 0)
        minimizeButton.Position = UDim2.new(1, -60, 0, 0)
        minimizeButton.BackgroundTransparency = 1
        minimizeButton.Text = "-"
        minimizeButton.TextColor3 = theme.Text
        minimizeButton.Font = Enum.Font.SourceSansBold
        minimizeButton.TextSize = 20
        minimizeButton.Parent = topBar

        closeButton = Instance.new("TextButton")
        closeButton.Size = UDim2.new(0, 30, 1, 0)
        closeButton.Position = UDim2.new(1, -30, 0, 0)
        closeButton.BackgroundTransparency = 1
        closeButton.Text = "X"
        closeButton.TextColor3 = theme.Text
        closeButton.Font = Enum.Font.SourceSansBold
        closeButton.TextSize = 20
        closeButton.Parent = topBar

        sidebar = Instance.new("Frame")
        sidebar.Name = "Sidebar"
        sidebar.Size = UDim2.new(0, 150, 1, -30)
        sidebar.Position = UDim2.new(0, 0, 0, 30)
        sidebar.BackgroundColor3 = theme.Panel
        sidebar.BorderSizePixel = 0
        sidebar.Parent = mainFrame

        local sideLayout = Instance.new("UIListLayout")
        sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
        sideLayout.Padding = UDim.new(0, 5)
        sideLayout.Parent = sidebar

        local sidePadding = Instance.new("UIPadding")
        sidePadding.PaddingTop = UDim.new(0, 10)
        sidePadding.PaddingLeft = UDim.new(0, 10)
        sidePadding.PaddingRight = UDim.new(0, 10)
        sidePadding.Parent = sidebar

        content.Name = "Content"
        content.Size = UDim2.new(1, -150, 1, -30)
        content.Position = UDim2.new(0, 150, 0, 30)
        content.BackgroundColor3 = theme.Background
        content.BorderSizePixel = 0
        content.ClipsDescendants = true
        content.Parent = mainFrame

        if options.resizable then
            resizeCorner = Instance.new("TextButton")
            resizeCorner.Size = UDim2.new(0, 20, 0, 20)
            resizeCorner.Position = UDim2.new(1, -20, 1, -20)
            resizeCorner.BackgroundTransparency = 1
            resizeCorner.Text = ""
            resizeCorner.Parent = mainFrame
        end
    else
        -- Mobile mode
        mainFrame.Name = "Drawer"
        mainFrame.Size = UDim2.new(0, drawerWidth, 1, 0)
        mainFrame.Position = UDim2.new(0, -drawerWidth, 0, 0) -- Start closed
        mainFrame.BackgroundColor3 = theme.Panel
        mainFrame.BorderSizePixel = 0
        mainFrame.ClipsDescendants = true
        mainFrame.Parent = screenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = mainFrame

        local shadow = Instance.new("UIStroke")
        shadow.Transparency = 1 - theme.ShadowOpacity
        shadow.Color = theme.Shadow
        shadow.Thickness = 2
        shadow.Parent = mainFrame

        sidebar = mainFrame

        local sideLayout = Instance.new("UIListLayout")
        sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
        sideLayout.Padding = UDim.new(0, 5)
        sideLayout.Parent = sidebar

        local sidePadding = Instance.new("UIPadding")
        sidePadding.PaddingTop = UDim.new(0, 10)
        sidePadding.PaddingLeft = UDim.new(0, 10)
        sidePadding.PaddingRight = UDim.new(0, 10)
        sidePadding.Parent = sidebar

        content.Name = "Content"
        content.Size = UDim2.new(1, 0, 1, 0)
        content.Position = UDim2.new(0, 0, 0, 0)
        content.BackgroundColor3 = theme.Background
        content.BorderSizePixel = 0
        content.ClipsDescendants = true
        content.Parent = screenGui

        overlay = Instance.new("Frame")
        overlay.Name = "Overlay"
        overlay.Size = UDim2.new(1, 0, 1, 0)
        overlay.Position = UDim2.new(0, 0, 0, 0)
        overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        overlay.BackgroundTransparency = 0.5
        overlay.Visible = false
        overlay.ZIndex = 5
        overlay.Parent = screenGui
        mainFrame.ZIndex = 10
        content.ZIndex = 6

        overlay.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isOpen = false
                TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, -drawerWidth, 0, 0)}):Play()
                overlay.Visible = false
            end
        end)
    end

    -- Common logic
    local function updateLayout()
        if not mobilemode then return end
        local viewport = Camera.ViewportSize
        isLarge = viewport.X > 800
        if isLarge then
            mainFrame.Position = UDim2.new(0, 0, 0, 0)
            overlay.Visible = false
            content.Position = UDim2.new(0, drawerWidth, 0, 0)
            content.Size = UDim2.new(1, -drawerWidth, 1, 0)
            isOpen = true
        else
            content.Position = UDim2.new(0, 0, 0, 0)
            content.Size = UDim2.new(1, 0, 1, 0)
            if isOpen then
                mainFrame.Position = UDim2.new(0, 0, 0, 0)
                overlay.Visible = true
                overlay.Position = UDim2.new(0, drawerWidth, 0, 0)
                overlay.Size = UDim2.new(1, -drawerWidth, 1, 0)
            else
                mainFrame.Position = UDim2.new(0, -drawerWidth, 0, 0)
                overlay.Visible = false
            end
        end
    end
    updateLayout()
    table.insert(connections, Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLayout))

    if mobilemode then
        -- Improved mobile gesture detection
        local touchStartPos
        local isDragging = false
        local openThreshold = 50
        local closeThreshold = 50

        local function onTouchBegan(input, gp)
            if gp then return end
            local posX = input.Position.X
            if isOpen then
                if posX > drawerWidth then return end
            else
                if posX > 30 then return end
            end
            touchStartPos = input.Position
            isDragging = true
        end

        local function onTouchMoved(input, gp)
            if gp or not isDragging then return end
            local delta = input.Position - touchStartPos
            if math.abs(delta.Y) > math.abs(delta.X) then
                isDragging = false
                return
            end
            local newPos = math.clamp(delta.X, -drawerWidth, 0)
            if not isOpen then newPos = math.max(0, newPos) end
            mainFrame.Position = UDim2.new(0, newPos, 0, 0)
        end

        local function onTouchEnded(input, gp)
            if gp or not isDragging then return end
            isDragging = false
            local delta = input.Position - touchStartPos
            if not isOpen then
                if delta.X > openThreshold then
                    isOpen = true
                    TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
                    overlay.Visible = true
                else
                    TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, -drawerWidth, 0, 0)}):Play()
                end
            else
                if -delta.X > closeThreshold then
                    isOpen = false
                    TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, -drawerWidth, 0, 0)}):Play()
                    overlay.Visible = false
                else
                    TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
                end
            end
        end

        table.insert(connections, UIS.InputBegan:Connect(onTouchBegan))
        table.insert(connections, UIS.InputChanged:Connect(onTouchMoved))
        table.insert(connections, UIS.InputEnded:Connect(onTouchEnded))

        -- Auto-open on load for small screens
        task.wait(0.1)
        if not isLarge then
            isOpen = true
            mainFrame.Position = UDim2.new(0, 0, 0, 0)
            overlay.Visible = true
        end
    end

    -- Keybind toggle
    table.insert(connections, UIS.InputBegan:Connect(function(input, gp)
        if gp or input.KeyCode ~= options.keybind then return end
        visible = not visible
        if mobilemode then
            if isLarge then
                mainFrame.Visible = visible
                content.Visible = visible
            else
                isOpen = not isOpen
                if isOpen then
                    TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
                    overlay.Visible = true
                else
                    TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, -drawerWidth, 0, 0)}):Play()
                    overlay.Visible = false
                end
            end
        else
            mainFrame.Visible = visible
        end
    end))

    if not mobilemode then
        closeButton.MouseButton1Click:Connect(function()
            visible = false
            mainFrame.Visible = false
        end)

        minimizeButton.MouseButton1Click:Connect(function()
            minimized = not minimized
            sidebar.Visible = not minimized
            if minimized then
                content.Size = UDim2.new(1, 0, 1, -30)
                content.Position = UDim2.new(0, 0, 0, 30)
            else
                content.Size = UDim2.new(1, -150, 1, -30)
                content.Position = UDim2.new(0, 150, 0, 30)
            end
            minimizeButton.Text = minimized and "+" or "-"
        end)

        if options.draggable then
            local dragging = false
            local dragStart, startPos, dragInput

            local function updateInput(input)
                local delta = input.Position - dragStart
                mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end

            topBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    dragStart = input.Position
                    startPos = mainFrame.Position

                    local conn
                    conn = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            dragging = false
                            conn:Disconnect()
                        end
                    end)
                end
            end)

            topBar.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    dragInput = input
                end
            end)

            table.insert(connections, RS.Heartbeat:Connect(function()
                if dragging and dragInput then
                    updateInput(dragInput)
                end
            end))
        end

        if options.resizable and resizeCorner then
            local resizing = false
            local resizeStart, startSize

            resizeCorner.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    resizing = true
                    resizeStart = input.Position
                    startSize = mainFrame.Size

                    local conn
                    conn = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            resizing = false
                            conn:Disconnect()
                        end
                    end)
                end
            end)

            table.insert(connections, RS.Heartbeat:Connect(function()
                if resizing then
                    local currentInput = UIS:GetMouseLocation() -- Fallback for mouse
                    local delta = Vector2.new(currentInput.X, currentInput.Y) - resizeStart
                    mainFrame.Size = UDim2.new(startSize.X.Scale, startSize.X.Offset + delta.X, startSize.Y.Scale, startSize.Y.Offset + delta.Y)
                end
            end))
        end
    end

    local Window = {}

    -- CreateTab
    function Window:CreateTab(name, icon)
        local tab = {}

        local tabButton = Instance.new("TextButton")
        tabButton.Size = UDim2.new(1, 0, 0, 40)
        tabButton.BackgroundColor3 = theme.Panel
        tabButton.BorderSizePixel = 0
        tabButton.Text = mobilemode and "" or (" " .. name)
        tabButton.TextColor3 = theme.Text
        tabButton.Font = theme.Font
        tabButton.TextSize = 16
        tabButton.TextXAlignment = Enum.TextXAlignment.Left
        tabButton.Parent = sidebar

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = tabButton

        if icon and icon ~= "" then
            local iconLabel = Instance.new("ImageLabel")
            iconLabel.Size = UDim2.new(0, 30, 0, 30)
            iconLabel.Position = UDim2.new(0, 10, 0.5, -15)
            iconLabel.BackgroundTransparency = 1
            iconLabel.Image = icon
            iconLabel.ScaleType = Enum.ScaleType.Fit
            iconLabel.Parent = tabButton
        end

        local tabContent = Instance.new("ScrollingFrame") -- Use ScrollingFrame for better overflow handling
        tabContent.Name = name .. "Content"
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.BackgroundTransparency = 1
        tabContent.BorderSizePixel = 0
        tabContent.ScrollBarThickness = 6
        tabContent.ScrollBarImageColor3 = theme.Accent
        tabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
        tabContent.Visible = false
        tabContent.Parent = mobilemode and sidebar or content -- For mobile, tabs in sidebar; desktop in content

        local tabLayout = Instance.new("UIListLayout")
        tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
        tabLayout.Padding = UDim.new(0, 10)
        tabLayout.Parent = tabContent

        tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContent.CanvasSize = UDim2.new(0, 0, 0, tabLayout.AbsoluteContentSize.Y + 20)
        end)

        local tabPadding = Instance.new("UIPadding")
        tabPadding.PaddingLeft = UDim.new(0, 10)
        tabPadding.PaddingRight = UDim.new(0, 10)
        tabPadding.PaddingTop = UDim.new(0, 10)
        tabPadding.PaddingBottom = UDim.new(0, 10)
        tabPadding.Parent = tabContent

        local function selectTab()
            for _, t in pairs(tabs) do
                t.content.Visible = false
                t.button.BackgroundColor3 = theme.Panel
                t.button.TextTransparency = 0
                if t.icon then t.icon.ImageTransparency = 0 end
            end
            tabContent.Visible = true
            tabButton.BackgroundColor3 = theme.Background
            tabButton.TextTransparency = mobilemode and 1 or 0 -- Hide text on mobile
            if tab.icon then tab.icon.ImageTransparency = mobilemode and 0.5 or 0 end
            currentTab = tab
            if mobilemode and not isLarge then
                isOpen = false
                TS:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, -drawerWidth, 0, 0)}):Play()
                overlay.Visible = false
            end
        end

        tabButton.MouseButton1Click:Connect(selectTab)
        tabButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                TS:Create(tabButton, TweenInfo.new(0.1), {BackgroundColor3 = theme.Accent}):Play()
            end
        end)
        tabButton.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                TS:Create(tabButton, TweenInfo.new(0.1), {BackgroundColor3 = theme.Panel}):Play()
            end
        end)

        tab.button = tabButton
        tab.content = tabContent
        tab.icon = iconLabel
        table.insert(tabs, tab)

        if #tabs == 1 then
            selectTab()
        end

        -- CreateSection
        function tab:CreateSection(title)
            local section = Instance.new("Frame")
            section.Name = title .. "Section"
            section.Size = UDim2.new(1, 0, 0, 0)
            section.BackgroundColor3 = theme.Panel
            section.BorderSizePixel = 0
            section.AutomaticSize = Enum.AutomaticSize.Y
            section.Parent = tabContent

            local secCorner = Instance.new("UICorner")
            secCorner.CornerRadius = UDim.new(0, 8)
            secCorner.Parent = section

            local secShadow = Instance.new("UIStroke")
            secShadow.Transparency = 1 - theme.ShadowOpacity
            secShadow.Color = theme.Shadow
            secShadow.Thickness = 1
            secShadow.Parent = section

            local secTitle = Instance.new("TextLabel")
            secTitle.Size = UDim2.new(1, 0, 0, 25)
            secTitle.BackgroundTransparency = 1
            secTitle.Text = title
            secTitle.TextColor3 = theme.Text
            secTitle.Font = theme.Font
            secTitle.TextSize = 16
            secTitle.TextXAlignment = Enum.TextXAlignment.Left
            secTitle.Parent = section

            local secContent = Instance.new("Frame")
            secContent.Name = "Content"
            secContent.Size = UDim2.new(1, 0, 1, -25)
            secContent.Position = UDim2.new(0, 0, 0, 25)
            secContent.BackgroundTransparency = 1
            secContent.AutomaticSize = Enum.AutomaticSize.Y
            secContent.Parent = section

            local secLayout = Instance.new("UIListLayout")
            secLayout.SortOrder = Enum.SortOrder.LayoutOrder
            secLayout.Padding = UDim.new(0, 5)
            secLayout.Parent = secContent

            local secPadding = Instance.new("UIPadding")
            secPadding.PaddingLeft = UDim.new(0, 10)
            secPadding.PaddingRight = UDim.new(0, 10)
            secPadding.PaddingTop = UDim.new(0, 5)
            secPadding.PaddingBottom = UDim.new(0, 5)
            secPadding.Parent = secContent

            return secContent
        end

        -- AddButton (updated for visibility)
        function tab:AddButton(label, callback)
            local button = Instance.new("TextButton")
            button.Name = label .. "Button"
            button.Size = UDim2.new(1, 0, 0, 35)
            button.BackgroundColor3 = theme.Accent
            button.Text = label
            button.TextColor3 = Color3.new(1,1,1) -- White text for contrast
            button.Font = theme.Font
            button.TextSize = 14
            button.Parent = tab.content

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = button

            button.MouseButton1Click:Connect(function()
                pcall(callback)
                TS:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 0, 32)}):Play()
                task.wait(0.1)
                TS:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 0, 35)}):Play()
            end)

            button.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    TS:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = theme.Accent:lerp(Color3.new(0,0,0), 0.2)}):Play()
                end
            end)

            button.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    TS:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = theme.Accent}):Play()
                end
            end)

            return button
        end

        -- AddToggle (fixed sliding indicator)
        function tab:AddToggle(label, default, callback)
            local state = default or false
            local toggle = Instance.new("Frame")
            toggle.Name = label .. "Toggle"
            toggle.Size = UDim2.new(1, 0, 0, 35)
            toggle.BackgroundTransparency = 1
            toggle.Parent = tab.content

            local toggleLabel = Instance.new("TextLabel")
