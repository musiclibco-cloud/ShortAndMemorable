    -- Notify
    function Window:Notify(text, duration)
        duration = duration or 5
        local toast = Instance.new("Frame")
        toast.Size = UDim2.new(1, 0, 0, 40)
        toast.BackgroundColor3 = theme.Panel
        toast.BorderSizePixel = 0
        toast.Parent = notifications

        local toastCorner = Instance.new("UICorner")
        toastCorner.CornerRadius = UDim.new(0, 8)
        toastCorner.Parent = toast

        local toastText = Instance.new("TextLabel")
        toastText.Size = UDim2.new(1, -10, 1, 0)
        toastText.Position = UDim2.new(0, 5, 0, 0)
        toastText.BackgroundTransparency = 1
        toastText.Text = text
        toastText.TextColor3 = theme.Text
        toastText.Font = theme.Font
        toastText.TextSize = 14
        toastText.TextWrapped = true
        toastText.Parent = toast

        toast.BackgroundTransparency = 1
        TS:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()

        task.delay(duration, function()
            TS:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
            task.wait(0.3)
            toast:Destroy()
        end)
    end

    -- AddFPSMonitor (fixed positioning)
    function Window:AddFPSMonitor()
        if topBar then
            local fpsLabel = Instance.new("TextLabel")
            fpsLabel.Size = UDim2.new(0, 80, 0, 20)
            fpsLabel.Position = UDim2.new(1, -90, 0, 5)
            fpsLabel.BackgroundTransparency = 1
            fpsLabel.TextColor3 = theme.Text
            fpsLabel.Font = theme.Font
            fpsLabel.TextSize = 12
            fpsLabel.Text = "FPS: --"
            fpsLabel.Parent = topBar

            local lastTime = tick()
            local frameCount = 0

            local fpsConn = RS.RenderStepped:Connect(function()
                frameCount = frameCount + 1
                if tick() - lastTime >= 1 then
                    fpsLabel.Text = "FPS: " .. math.floor(frameCount)
                    frameCount = 0
                    lastTime = tick()
                end
            end)

            table.insert(connections, fpsConn)
            return fpsLabel
        else
            warn("[ForsakenLib] FPS Monitor only available in desktop mode.")
        end
    end

    -- Window unload
    function Window:Unload()
        for _, conn in pairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
        screenGui:Destroy()
    end

    -- Global unload fallback
    function ForsakenLib:Unload()
        for _, conn in pairs(globalConnections) do
            pcall(function() conn:Disconnect() end)
        end
        -- Assumes single window; extend for multi
        warn("[ForsakenLib] Unload called - manual cleanup recommended for multi-window.")
    end

    table.insert(globalConnections, function()
        for _, conn in pairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
        screenGui:Destroy()
    end)

    return Window
end

