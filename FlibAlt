local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local ForsakenLib = {}
ForsakenLib.Version = "1.1.0"

-- // CONFIG //
local CONFIG = {
    DrawerHeight = 260,
    AccentColor = Color3.fromRGB(0, 255, 255), -- cyan
    BaseColor = Color3.fromRGB(15, 15, 20),    -- black
    HighlightColor = Color3.fromRGB(255, 105, 180), -- pink accent
    ButtonSize = UDim2.fromOffset(48, 48),
}

-- // PARENT //
local parent = gethui and gethui() or game:FindFirstChildOfClass("CoreGui") or game.Players.LocalPlayer:WaitForChild("PlayerGui")

-- // MAIN STRUCTURE //
local Drawer = Instance.new("Frame")
Drawer.Name = "Forsaken_Drawer"
Drawer.Size = UDim2.new(1, 0, 0, CONFIG.DrawerHeight)
Drawer.Position = UDim2.new(0, 0, 1, 0)
Drawer.BackgroundColor3 = CONFIG.BaseColor
Drawer.BorderSizePixel = 0
Drawer.BackgroundTransparency = 0.1
Drawer.ZIndex = 100
Drawer.Parent = parent

local Corner = Instance.new("UICorner", Drawer)
Corner.CornerRadius = UDim.new(0, 16)

local Layout = Instance.new("UIListLayout", Drawer)
Layout.FillDirection = Enum.FillDirection.Vertical
Layout.Padding = UDim.new(0, 8)
Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

-- // DRAGGABLE "F" BUTTON //
local ToggleButton = Instance.new("ImageButton")
ToggleButton.Name = "Forsaken_Toggle"
ToggleButton.Size = CONFIG.ButtonSize
ToggleButton.Position = UDim2.new(0.5, -24, 1, -64)
ToggleButton.AnchorPoint = Vector2.new(0.5, 0.5)
ToggleButton.BackgroundColor3 = CONFIG.BaseColor
ToggleButton.ImageColor3 = CONFIG.AccentColor
ToggleButton.Image = "rbxassetid://7734053427" -- stylized F
ToggleButton.ZIndex = 101
ToggleButton.Active = true
ToggleButton.Draggable = true
ToggleButton.Parent = parent

local CornerBtn = Instance.new("UICorner", ToggleButton)
CornerBtn.CornerRadius = UDim.new(0, 10)

-- subtle drop shadow
local Shadow = Instance.new("UIStroke", ToggleButton)
Shadow.Thickness = 1.5
Shadow.Color = CONFIG.HighlightColor
Shadow.Transparency = 0.4

-- // ANIMATION //
local isOpen = false
local function toggleDrawer()
	isOpen = not isOpen
	TweenService:Create(Drawer, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = isOpen and UDim2.new(0, 0, 1, -CONFIG.DrawerHeight) or UDim2.new(0, 0, 1, 0)
	}):Play()

	TweenService:Create(ToggleButton, TweenInfo.new(0.25), {
		Rotation = isOpen and 180 or 0
	}):Play()
end
ToggleButton.MouseButton1Click:Connect(toggleDrawer)

-- // ELEMENT HELPERS //
local function createBaseElement(title)
	local element = Instance.new("Frame")
	element.Name = title
	element.Size = UDim2.new(0.95, 0, 0, 40)
	element.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	element.BorderSizePixel = 0
	element.BackgroundTransparency = 0.1
	element.ZIndex = 101

	local corner = Instance.new("UICorner", element)
	corner.CornerRadius = UDim.new(0, 10)

	local label = Instance.new("TextLabel", element)
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -12, 1, 0)
	label.Position = UDim2.new(0, 6, 0, 0)
	label.Font = Enum.Font.SourceSansBold
	label.Text = title
	label.TextColor3 = CONFIG.AccentColor
	label.TextSize = 18
	label.TextXAlignment = Enum.TextXAlignment.Left

	return element
end

-- // BUTTON //
function ForsakenLib:AddButton(title, callback)
	local btn = createBaseElement(title)
	btn.BackgroundColor3 = CONFIG.AccentColor
	btn.TextLabel.TextColor3 = CONFIG.BaseColor
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = CONFIG.HighlightColor}):Play()
			task.wait(0.1)
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = CONFIG.AccentColor}):Play()
			if callback then pcall(callback) end
		end
	end)
	btn.Parent = Drawer
end

-- // TOGGLE //
function ForsakenLib:AddToggle(title, default, callback)
	local element = createBaseElement(title)
	local toggleBtn = Instance.new("Frame", element)
	toggleBtn.Size = UDim2.new(0, 40, 0, 20)
	toggleBtn.AnchorPoint = Vector2.new(1, 0.5)
	toggleBtn.Position = UDim2.new(1, -8, 0.5, 0)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)

	local corner = Instance.new("UICorner", toggleBtn)
	corner.CornerRadius = UDim.new(1, 0)

	local indicator = Instance.new("Frame", toggleBtn)
	indicator.Size = UDim2.new(0, 18, 0, 18)
	indicator.Position = UDim2.new(default and 1 or 0, default and -19 or 1, 0.5, -9)
	indicator.BackgroundColor3 = default and CONFIG.AccentColor or CONFIG.HighlightColor
	indicator.ZIndex = 103

	local corner2 = Instance.new("UICorner", indicator)
	corner2.CornerRadius = UDim.new(1, 0)

	local state = default
	element.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			state = not state
			TweenService:Create(indicator, TweenInfo.new(0.2), {
				Position = UDim2.new(state and 1 or 0, state and -19 or 1, 0.5, -9),
				BackgroundColor3 = state and CONFIG.AccentColor or CONFIG.HighlightColor
			}):Play()
			if callback then pcall(callback, state) end
		end
	end)
	element.Parent = Drawer
end

-- // LABEL //
function ForsakenLib:AddLabel(text)
	local label = createBaseElement(text)
	label.BackgroundTransparency = 1
	label.TextLabel.TextColor3 = CONFIG.HighlightColor
	label.TextLabel.TextSize = 16
	label.Parent = Drawer
end

-- // NOTIFY //
function ForsakenLib:Notify(title, msg, time)
	local note = Instance.new("TextLabel")
	note.Size = UDim2.new(0.9, 0, 0, 40)
	note.Position = UDim2.new(0.05, 0, 1, -50)
	note.BackgroundColor3 = CONFIG.BaseColor
	note.TextColor3 = CONFIG.AccentColor
	note.Font = Enum.Font.SourceSansBold
	note.TextSize = 18
	note.Text = title .. " | " .. msg
	note.ZIndex = 200
	note.Parent = parent

	local corner = Instance.new("UICorner", note)
	corner.CornerRadius = UDim.new(0, 10)

	TweenService:Create(note, TweenInfo.new(0.3), {Position = UDim2.new(0.05, 0, 1, -120)}):Play()
	task.wait(time or 2)
	TweenService:Create(note, TweenInfo.new(0.3), {Position = UDim2.new(0.05, 0, 1, 0)}):Play()
	task.wait(0.3)
	note:Destroy()
end

-- // CLEANUP //
function ForsakenLib:Unload()
	if Drawer then Drawer:Destroy() end
	if ToggleButton then ToggleButton:Destroy() end
end

return ForsakenLib