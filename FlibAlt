-- Fixed ColorPicker implementation (simple RGB sliders + HEX preview)
function SectionProto:AddColorPicker(label, defaultColor, callback)
    callback = callback or function() end
    defaultColor = defaultColor or ThemeState.current.Accent
    local content = self._content
    if not content then return end
    local row = new("Frame", {Parent = content, Size = UDim2.new(1,0,0,44), BackgroundTransparency = 1})
    local title = makeTextLabel(row, {Text = label or "Color", Size = UDim2.new(0.55, 0, 1, 0)})
    local preview = new("TextButton", {Parent = row, Size = UDim2.new(0, 40, 0, 28), Position = UDim2.new(1, -48, 0, 8), BackgroundColor3 = defaultColor, BorderSizePixel = 0, Text = ""})
    new("UICorner", {Parent = preview, CornerRadius = UDim.new(0,6)})

    local pickerOpened = false
    local pickerFrame

    local function createRGBSlider(parent, labelText, minV, maxV, initV, onChange)
        local container = new("Frame", {Parent = parent, Size = UDim2.new(1,0,0,28), BackgroundTransparency = 1})
        local lbl = makeTextLabel(container, {Text = labelText, Size = UDim2.new(0.2, 0, 1, 0)})
        local bar = new("Frame", {Parent = container, Size = UDim2.new(0.75, 0, 0, 10), Position = UDim2.new(0.24, 0, 0.5, -5), BackgroundColor3 = Color3.fromRGB(200,200,200), BorderSizePixel = 0})
        new("UICorner", {Parent = bar, CornerRadius = UDim.new(0,6)})
        local fill = new("Frame", {Parent = bar, Size = UDim2.new((initV-minV)/(maxV-minV),0,1,0), BackgroundColor3 = ThemeState.current.Accent, BorderSizePixel = 0})
        new("UICorner", {Parent = fill, CornerRadius = UDim.new(0,6)})
        local dragging = false
        local function setFromX(x)
            local barAbs = bar.AbsoluteSize.X
            if barAbs <= 0 then return end
            local rel = clamp(x / barAbs, 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            local value = minV + rel * (maxV - minV)
            pcall(onChange, math.floor(value))
        end
        trackConnection(bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local absX = (input.Position and input.Position.X or UserInputService:GetMouseLocation().X) - bar.AbsolutePosition.X
                setFromX(absX)
            end
        end))
        trackConnection(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local absX = UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X
                setFromX(absX)
            end
        end))
        trackConnection(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end))
        return {Set = function(v) local rel = clamp((v-minV)/(maxV-minV), 0, 1); fill.Size = UDim2.new(rel,0,1,0); pcall(onChange, math.floor(v)) end}
    end

    trackConnection(preview.MouseButton1Click and preview.MouseButton1Click or preview.InputBegan:Connect(function()
        if pickerOpened then
            if pickerFrame and pickerFrame.Parent then pickerFrame:Destroy() end
            pickerOpened = false
            return
        end
        pickerFrame = new("Frame", {Parent = row, Size = UDim2.new(1,0,0,150), Position = UDim2.new(0,0,1,4), BackgroundColor3 = ThemeState.current.Panel, BorderSizePixel = 0})
        new("UICorner", {Parent = pickerFrame, CornerRadius = UDim.new(0,8)})
        local rVal, gVal, bVal = math.floor(defaultColor.R*255), math.floor(defaultColor.G*255), math.floor(defaultColor.B*255)
        local function updatePreview()
            local c = Color3.fromRGB(clamp(rVal,0,255), clamp(gVal,0,255), clamp(bVal,0,255))
            preview.BackgroundColor3 = c
            pcall(callback, c)
        end
        -- slider rows
        local rSlider = createRGBSlider(pickerFrame, "R", 0, 255, rVal, function(v) rVal = v; updatePreview() end)
        local gSlider = createRGBSlider(pickerFrame, "G", 0, 255, gVal, function(v) gVal = v; updatePreview() end)
        local bSlider = createRGBSlider(pickerFrame, "B", 0, 255, bVal, function(v) bVal = v; updatePreview() end)
        pickerOpened = true
    end))
    return preview
end

