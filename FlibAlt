-- CreateWindow
function ForsakenLib:CreateWindow(title, options)
    options = options or {}
    local win = setmetatable({}, WindowProto)
    win.Title = title or "Forsaken"
    win.Options = options

    -- Make mobile mode default true for mobile-first usage (user requested mobile-only)
    if options.mobilemode == nil then options.mobilemode = true end

    local parent = ParentGui
    if not parent then
        warn("[ForsakenLib] No parent GUI available; returning dummy window.")
        function win:CreateTab() return {} end
        function win:Unload() end
        return win
    end

    local screenGui = new("ScreenGui", {Parent = parent, ResetOnSpawn = false, Name = ("Forsaken_Window_%d"):format(#_windows + 1)})
    local rootFrame = makeNeumorphicFrame(screenGui, UDim2.new(0, 720, 0, 480), UDim2.new(0.5, -360, 0.5, -240), DEFAULTS.CornerRadius)
    rootFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    rootFrame.Position = options.position or UDim2.new(0.5, 0, 0.5, 0)

    local topBar, minBtn, closeBtn = makeTopBar(rootFrame, win.Title)

    local sidebar = new("Frame", {Parent = rootFrame, Size = UDim2.new(0, 180, 1, -34), Position = UDim2.new(0, 0, 0, 34), BackgroundTransparency = 1})
    local content = new("Frame", {Parent = rootFrame, Size = UDim2.new(1, -180, 1, -34), Position = UDim2.new(0, 180, 0, 34), BackgroundTransparency = 1})
    new("UIListLayout", {Parent = sidebar, SortOrder = Enum.SortOrder.LayoutOrder})
    new("UIListLayout", {Parent = content, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,8)})
    win._gui = screenGui
    win._root = rootFrame
    win._sidebar = sidebar
    win._content = content
    win._tabs = {}

    -- Drawer & overlay (mobile)
    local drawer, overlay
    local function createDrawer()
        if drawer and drawer.Parent then return end
        drawer = new("Frame", {Parent = screenGui, Size = UDim2.new(0, 260, 1, 0), Position = UDim2.new(-1, 0, 0, 0), BackgroundColor3 = ThemeState.current.Panel, BorderSizePixel = 0, ZIndex = 1000})
        new("UICorner", {Parent = drawer, CornerRadius = DEFAULTS.CornerRadius})
        overlay = new("Frame", {Parent = screenGui, BackgroundTransparency = 0.6, BackgroundColor3 = Color3.new(0,0,0), Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0,0,0,0), Visible = false, ZIndex = 900})
        trackConnection(overlay.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                tween(drawer, {Position = UDim2.new(-1, 0, 0, 0)}, DEFAULTS.Animation.Info)
                if overlay then overlay.Visible = false end
            end
        end))
    end

    function win:SetMobileModeEnabled(state)
        win._mobileEnabled = state and true or false
        if win._mobileEnabled then
            createDrawer()
            sidebar.Visible = false
            if drawer then
                drawer.Position = UDim2.new(-1, 0, 0, 0)
                tween(drawer, {Position = UDim2.new(0, 0, 0, 0)}, DEFAULTS.Animation.Info)
            end
            if overlay then overlay.Visible = true end
        else
            if drawer then tween(drawer, {Position = UDim2.new(-1, 0, 0, 0)}, DEFAULTS.Animation.Info) end
            if overlay then overlay.Visible = false end
            sidebar.Visible = true
        end
    end

    -- default mobile behavior
    win:SetMobileModeEnabled(options.mobilemode)

    -- drag via top bar (touch + mouse)
    if options.draggable ~= false then
        local dragging, dragOffset
        trackConnection(topBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                local abs = rootFrame.AbsolutePosition
                dragOffset = Vector2.new(input.Position.X - abs.X, input.Position.Y - abs.Y)
            end
        end))
        trackConnection(UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.Touch or dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = UserInputService:GetMouseLocation()
                rootFrame.Position = UDim2.new(0, pos.X - dragOffset.X + rootFrame.AbsoluteSize.X/2, 0, pos.Y - dragOffset.Y + rootFrame.AbsoluteSize.Y/2)
            end
        end))
        trackConnection(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end))
    end

    -- controls
    trackConnection(minBtn.MouseButton1Click:Connect(function() content.Visible = not content.Visible; sidebar.Visible = not sidebar.Visible end))
    trackConnection(closeBtn.MouseButton1Click:Connect(function() win:Unload() end))

    function win:CreateTab(name, icon)
        local tab = setmetatable({}, TabProto)
        tab.Name = name
        tab._sections = {}
        tab._parentWindow = win

        -- sidebar button
        local btn = new("TextButton", {Parent = sidebar, Size = UDim2.new(1, -12, 0, 44), BackgroundColor3 = ThemeState.current.Panel, Text = " "..(name or "Tab"), TextSize = 14, Font = Enum.Font.SourceSans, TextColor3 = ThemeState.current.Text, BorderSizePixel = 0, AutoButtonColor = true})
        new("UICorner", {Parent = btn, CornerRadius = DEFAULTS.CornerRadius})

        trackConnection(btn.MouseButton1Click:Connect(function()
            for _, child in ipairs(content:GetChildren()) do if child:IsA("Frame") then child.Visible = false end end
            if not tab._frame or not tab._frame.Parent then
                local frame = new("Frame", {Parent = content, Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0, 6, 0, 6), BackgroundTransparency = 1})
                new("UIListLayout", {Parent = frame, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,8)})
                new("UIPadding", {Parent = frame, PaddingTop = UDim.new(0,6), PaddingLeft = UDim.new(0,6), PaddingRight = UDim.new(0,6)})
                tab._frame = frame
            end
            tab._frame.Visible = true
        end))

        -- drawer representation (mobile)
        if drawer then
            local dbtn = new("TextButton", {Parent = drawer, Size = UDim2.new(1, -12, 0, 44), BackgroundColor3 = ThemeState.current.Panel, Text = " "..(name or "Tab"), TextSize = 14, Font = Enum.Font.SourceSans, TextColor3 = ThemeState.current.Text, BorderSizePixel = 0, AutoButtonColor = true})
            new("UICorner", {Parent = dbtn, CornerRadius = DEFAULTS.CornerRadius})
            trackConnection(dbtn.MouseButton1Click:Connect(function()
                btn.MouseButton1Click:Fire()
                tween(drawer, {Position = UDim2.new(-1, 0, 0, 0)}, DEFAULTS.Animation.Info)
                if overlay then overlay.Visible = false end
            end))
        end

        tab._button = btn
        table.insert(win._tabs, tab)
        return tab
    end

    function win:Unload()
        for _, c in ipairs(_connections) do pcall(function() c:Disconnect() end) end
        _connections = {}
        pcall(function() if screenGui and screenGui.Parent then screenGui:Destroy() end end)
        for i, w in ipairs(_windows) do if w == win then table.remove(_windows, i); break end end
    end

    table.insert(_windows, win)
    return win
end

-- Section & Widgets
function TabProto:AddSection(title)
    local section = setmetatable({}, SectionProto)
    section.Title = title or ""
    section._items = {}

    if not self._frame then
        if self._button then self._button.MouseButton1Click:Fire() end
    end
    local parentFrame = self._frame or (self._parentWindow and self._parentWindow._content)
    if parentFrame then
        local secFrame = new("Frame", {Parent = parentFrame, Size = UDim2.new(1,0,0,64), BackgroundColor3 = ThemeState.current.Panel, BorderSizePixel = 0})
        new("UICorner", {Parent = secFrame, CornerRadius = DEFAULTS.CornerRadius})
        local header = makeTextLabel(secFrame, {Text = title or "", Size = UDim2.new(1, -12, 0, 22), Position = UDim2.new(0, 8, 0, 6), Font = Enum.Font.SourceSansBold})
        local content = new("Frame", {Parent = secFrame, Size = UDim2.new(1, -12, 1, -34), Position = UDim2.new(0, 8, 0, 30), BackgroundTransparency = 1})
        new("UIListLayout", {Parent = content, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,8)})
        section._frame = secFrame
        section._content = content
    else
        section._frame = nil
        section._content = nil
    end

    table.insert(self._sections, section)
    return section
end

function SectionProto:AddButton(label, callback)
    callback = callback or function() end
    local content = self._content
    if not content then return end
    local btn = new("TextButton", {Parent = content, Size = UDim2.new(1,0,0,36), Text = label or "Button", TextSize = 14, Font = Enum.Font.SourceSans, BackgroundColor3 = ThemeState.current.Panel, TextColor3 = ThemeState.current.Text, BorderSizePixel = 0, AutoButtonColor = true})
    new("UICorner", {Parent = btn, CornerRadius = UDim.new(0,8)})
    trackConnection(btn.MouseButton1Click:Connect(function()
        pcall(callback, true)
        local orig = btn.BackgroundTransparency
        tween(btn, {BackgroundTransparency = 0.6}, DEFAULTS.Animation.Info)
        delay(0.12, function() tween(btn, {BackgroundTransparency = orig}, DEFAULTS.Animation.Info) end)
    end))
    table.insert(self._items, btn)
    return btn
end

function SectionProto:AddToggle(label, default, callback)
    callback = callback or function() end
    default = default and true or false
    local content = self._content
    if not content then return end
    local row = new("Frame", {Parent = content, Size = UDim2.new(1,0,0,36), BackgroundTransparency = 1})
    local text = makeTextLabel(row, {Text = label or "Toggle", Size = UDim2.new(0.7,0,1,0)})
    local toggle = new("ImageButton", {Parent = row, Size = UDim2.new(0,44,0,24), Position = UDim2.new(1, -48, 0, 6), BackgroundColor3 = ThemeState.current.Panel, AutoButtonColor = true, BorderSizePixel = 0})
    new("UICorner", {Parent = toggle, CornerRadius = UDim.new(0,12)})
    local knob = new("Frame", {Parent = toggle, Size = UDim2.new(0.5, -4, 1, -4), Position = default and UDim2.new(0.5, 4, 0, 2) or UDim2.new(0, 2, 0, 2), BackgroundColor3 = default and ThemeState.current.Accent or Color3.fromRGB(200,200,200), BorderSizePixel = 0})
    new("UICorner", {Parent = knob, CornerRadius = UDim.new(0,10)})
    local state = default
    trackConnection(toggle.MouseButton1Click:Connect(function()
        state = not state
        if state then
            tween(knob, {Position = UDim2.new(0.5, 4, 0, 2)}, DEFAULTS.Animation.Info)
            tween(knob, {BackgroundColor3 = ThemeState.current.Accent}, DEFAULTS.Animation.Info)
        else
            tween(knob, {Position = UDim2.new(0, 2, 0, 2)}, DEFAULTS.Animation.Info)
            tween(knob, {BackgroundColor3 = Color3.fromRGB(200,200,200)}, DEFAULTS.Animation.Info)
        end
        pcall(callback, state)
    end))
    table.insert(self._items, {type="toggle", widget=toggle})
    return toggle, function() return state end
end

function SectionProto:AddSlider(label, minVal, maxVal, default, callback)
    callback = callback or function() end
    minVal = minVal or 0
    maxVal = maxVal or 100
    default = default or minVal
    local content = self._content
    if not content then return end
    local row = new("Frame", {Parent = content, Size = UDim2.new(1,0,0,56), BackgroundTransparency = 1})
    local title = makeTextLabel(row, {Text = label or "Slider", Size = UDim2.new(1,0,0,18)})
    local bar = new("Frame", {Parent = row, Size = UDim2.new(1,0,0,12), Position = UDim2.new(0,0,0,22), BackgroundColor3 = Color3.fromRGB(200,200,200), BorderSizePixel = 0})
    new("UICorner", {Parent = bar, CornerRadius = UDim.new(0,8)})
    local fill = new("Frame", {Parent = bar, Size = UDim2.new( (default-minVal)/(maxVal-minVal), 0, 1, 0 ), BackgroundColor3 = ThemeState.current.Accent, BorderSizePixel = 0})
    new("UICorner", {Parent = fill, CornerRadius = UDim.new(0,8)})
    local dragging = false
    local function setFromX(x)
        local barAbs = bar.AbsoluteSize.X
        if barAbs <= 0 then return end
        local rel = clamp(x / barAbs, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        local value = minVal + rel * (maxVal - minVal)
        pcall(callback, value)
    end
    trackConnection(bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local absX = (input.Position and input.Position.X or UserInputService:GetMouseLocation().X) - bar.AbsolutePosition.X
            setFromX(absX)
        end
    end))
    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local absX = UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X
            setFromX(absX)
        end
    end))
    trackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return {Set = function(val) local rel = clamp((val-minVal)/(maxVal-minVal), 0, 1); fill.Size = UDim2.new(rel,0,1,0); pcall(callback, val) end}
end

