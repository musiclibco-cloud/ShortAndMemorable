local NotificationQueue = {}
local NotificationsGui
local function ensureNotificationsGui()
    if NotificationsGui and NotificationsGui.Parent then return NotificationsGui end
    local parent = ParentGui
    if not parent then return end
    NotificationsGui = new("ScreenGui", {Parent = parent, Name = "Forsaken_Notifications", ResetOnSpawn = false})
    local container = new("Frame", {
        Parent = NotificationsGui,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 320, 0, 200),
        Position = UDim2.new(1, -340, 0, 24) -- top-right
    })
    new("UIListLayout", {Parent = container, SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top, Padding = UDim.new(0, 8)})
    NotificationsGui._container = container
    return NotificationsGui
end

local function showNotification(text, duration)
    duration = duration or 3
    local gui = ensureNotificationsGui()
    if not gui then return end
    local container = gui._container
    local frame = new("Frame", {
        Parent = container,
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = ThemeState.current.Panel,
        BorderSizePixel = 0,
        LayoutOrder = 1,
        ClipsDescendants = true
    })
    new("UICorner", {Parent = frame, CornerRadius = DEFAULTS.CornerRadius})
    local lbl = makeTextLabel(frame, {Text = text, Size = UDim2.new(1,-16,1,-8), Position = UDim2.new(0,8,0,6), TextSize = 14})
    frame.CanvasSize = nil
    frame.Position = UDim2.new(1, 0, 0, 0)
    frame.BackgroundTransparency = 1
    -- animate in
    frame.Position = UDim2.new(1, 0, 0, 0)
    tween(frame, {Position = UDim2.new(0, 0, frame.Position.Y.Scale, frame.Position.Y.Offset)}, DEFAULTS.Animation.Info)
    -- fade in
    pcall(function() frame.BackgroundTransparency = 0 end)
    delay(duration, function()
        pcall(function()
            tween(frame, {Position = UDim2.new(1, 0, frame.Position.Y.Scale, frame.Position.Y.Offset)}, DEFAULTS.Animation.Info)
            wait(0.2)
            frame:Destroy()
        end)
    end)
end

ForsakenLib.Notify = function(text, duration)
    pcall(function() showNotification(text, duration) end)
end

