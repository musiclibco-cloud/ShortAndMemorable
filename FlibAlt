-- Nostalgic. Modern. Executor-safe.

local ForsakenLib = {}
ForsakenLib.Version = "1.0.1"

-- safe wrappers
local function safeEval(func, ...)
    local ok, res = pcall(func, ...)
    return ok and res or nil
end
local function safeCall(func, ...)
    local ok, err = pcall(func, ...)
    if not ok then warn("[ForsakenLib] safeCall error:", tostring(err)) end
    return ok, err
end

local ExecutorName = safeEval(function()
    if type(getexecutorname) == "function" then
        local ok, name = pcall(getexecutorname)
        if ok and name then return name end
    end
    return "Unknown"
end) or "Unknown"
ForsakenLib.Executor = ExecutorName

-- Parent selection (gethui / CoreGui / PlayerGui)
local function getParentGui()
    -- try gethui
    if type(gethui) == "function" then
        local ok, g = pcall(gethui)
        if ok and g then return g end
    end
    -- CoreGui
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    -- PlayerGui
    local ok2, pl = pcall(function() return game.Players.LocalPlayer end)
    if ok2 and pl then
        local pg = pl:FindFirstChild("PlayerGui") or pl:WaitForChild("PlayerGui", 3)
        if pg then return pg end
    end
    warn("[ForsakenLib] Could not find a safe parent GUI (gethui/CoreGui/PlayerGui). UI may not display.")
    return nil
end

