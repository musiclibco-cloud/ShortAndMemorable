local function makeNeumorphicFrame(parent, size, pos, cornerRadius)
    local frame = new("Frame", {
        Parent = parent,
        Size = size or UDim2.new(0, 300, 0, 200),
        Position = pos or UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = ThemeState.current.Panel,
        BorderSizePixel = 0,
    })

    local uic = new("UICorner", {Parent = frame})
    if cornerRadius then pcall(function() uic.CornerRadius = cornerRadius end) end

    -- soft inner highlight
    local topHighlight = new("Frame", {
        Parent = frame,
        BackgroundColor3 = ThemeState.current.Glow,
        BackgroundTransparency = 0.9,
        Size = UDim2.new(1, -6, 0, 6),
        Position = UDim2.new(0, 3, 0, 3),
        BorderSizePixel = 0,
        ZIndex = frame.ZIndex + 1
    })
    new("UICorner", {Parent = topHighlight, CornerRadius = cornerRadius or DEFAULTS.CornerRadius})

    -- subtle shadow (simulated via image label for better performance)
    local shadow = new("ImageLabel", {
        Parent = frame,
        Size = UDim2.new(1, 12, 1, 12),
        Position = UDim2.new(0, -6, 0, -6),
        BackgroundTransparency = 1,
        Image = "rbxasset://textures/ui/GuiImagePlaceholder.png", -- invisible placeholder; used for layering only
        ImageTransparency = 1,
        ZIndex = 0
    })
    return frame
end

-- text label builder
local function makeTextLabel(parent, props)
    local lbl = new("TextLabel", {
        Parent = parent,
        Size = props.Size or UDim2.new(1,0,0,20),
        Position = props.Position or UDim2.new(0,0,0,0),
        BackgroundTransparency = props.BackgroundTransparency or 1,
        Text = props.Text or "",
        TextColor3 = props.TextColor3 or ThemeState.current.Text,
        TextSize = props.TextSize or 14,
        Font = props.Font or Enum.Font.SourceSans,
        TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
        TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center,
        ZIndex = props.ZIndex or 10,
        TextWrapped = props.TextWrapped or false,
        RichText = props.RichText or false,
    })
    return lbl
end

