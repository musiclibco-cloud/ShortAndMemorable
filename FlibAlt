-- UI helpers
local function makeNeumorphicFrame(parent, size, pos, cornerRadius)
    local frame = new("Frame", {
        Parent = parent,
        Size = size or UDim2.new(0, 300, 0, 200),
        Position = pos or UDim2.new(0,0,0,0),
        BackgroundColor3 = ThemeState.current.Panel,
        BorderSizePixel = 0
    })
    new("UICorner", {Parent = frame, CornerRadius = cornerRadius or DEFAULTS.CornerRadius})
    return frame
end

local function makeTextLabel(parent, props)
    props = props or {}
    local lbl = new("TextLabel", {
        Parent = parent,
        Size = props.Size or UDim2.new(1,0,0,20),
        Position = props.Position or UDim2.new(0,0,0,0),
        BackgroundTransparency = props.BackgroundTransparency or 1,
        Text = props.Text or "",
        TextColor3 = props.TextColor3 or ThemeState.current.Text,
        TextSize = props.TextSize or 14,
        Font = props.Font or Enum.Font.SourceSans,
        TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
        TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center,
        TextWrapped = props.TextWrapped or false,
        RichText = props.RichText or false
    })
    return lbl
end

-- Notifications
local NotificationsGui, NotificationsContainer
local function ensureNotificationsGui()
    if NotificationsGui and NotificationsGui.Parent then return NotificationsGui end
    local parent = ParentGui
    if not parent then return nil end
    NotificationsGui = new("ScreenGui", {Parent = parent, Name = "Forsaken_Notifications", ResetOnSpawn = false})
    NotificationsContainer = new("Frame", {
        Parent = NotificationsGui,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 320, 0, 200),
        Position = UDim2.new(1, -340, 0, 24)
    })
    new("UIListLayout", {Parent = NotificationsContainer, SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top, Padding = UDim.new(0, 8)})
    return NotificationsGui
end

local function showNotification(text, duration)
    duration = duration or 3
    local gui = ensureNotificationsGui()
    if not gui then return end
    local container = NotificationsContainer
    local frame = new("Frame", {
        Parent = container,
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = ThemeState.current.Panel,
        BorderSizePixel = 0,
        LayoutOrder = 1,
        ClipsDescendants = true,
        AnchorPoint = Vector2.new(1,0),
        Position = UDim2.new(1, 0, 0, 0) -- start off-screen to the right of its container's coordinate space
    })
    new("UICorner", {Parent = frame, CornerRadius = DEFAULTS.CornerRadius})
    makeTextLabel(frame, {Text = text, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.new(0, 8, 0, 8), TextSize = 14})
    -- animate in: move to Position 0,0 relative to container
    tween(frame, {Position = UDim2.new(0, 0, 0, 0)}, DEFAULTS.Animation.Info)
    delay(duration, function()
        if frame and frame.Parent then
            tween(frame, {Position = UDim2.new(1, 0, 0, 0)}, DEFAULTS.Animation.Info)
            delay(0.2, function() pcall(function() if frame and frame.Parent then frame:Destroy() end end) end)
        end
    end)
end

ForsakenLib.Notify = function(text, duration)
    pcall(function() showNotification(text, duration) end)
end

