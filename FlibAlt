function SectionProto:AddDropdown(label, items, callback)
    callback = callback or function() end
    items = items or {}
    local content = self._content
    if not content then return end
    local row = new("Frame", {Parent = content, Size = UDim2.new(1,0,0,38), BackgroundTransparency = 1})
    local title = makeTextLabel(row, {Text = label or "Dropdown", Size = UDim2.new(0.5,0,1,0)})
    local btn = new("TextButton", {Parent = row, Size = UDim2.new(0.5, -12, 0, 28), Position = UDim2.new(0.5, 8, 0, 4), Text = "Select...", BackgroundColor3 = ThemeState.current.Panel, BorderSizePixel = 0, TextColor3 = ThemeState.current.Text})
    new("UICorner", {Parent = btn, CornerRadius = UDim.new(0,8)})
    local expanded = false
    local listFrame
    local function toggleList()
        if expanded then
            if listFrame then listFrame:Destroy(); listFrame = nil end
            expanded = false
        else
            listFrame = new("Frame", {Parent = row, Size = UDim2.new(1,0,0, #items * 30), Position = UDim2.new(0, 0, 1, 4), BackgroundColor3 = ThemeState.current.Panel, BorderSizePixel = 0})
            new("UICorner", {Parent = listFrame, CornerRadius = UDim.new(0, 8)})
            for i, v in ipairs(items) do
                local itemBtn = new("TextButton", {Parent = listFrame, Size = UDim2.new(1,0,0,28), Position = UDim2.new(0,0,0,(i-1)*28), Text = tostring(v), BackgroundTransparency = 1, TextColor3 = ThemeState.current.Text, BorderSizePixel = 0})
                trackConnection(itemBtn.MouseButton1Click:Connect(function()
                    btn.Text = tostring(v)
                    toggleList()
                    pcall(callback, v)
                end))
            end
            expanded = true
        end
    end
    trackConnection(btn.MouseButton1Click:Connect(toggleList))
    return btn
end

function SectionProto:AddKeybind(label, defaultKey, callback)
