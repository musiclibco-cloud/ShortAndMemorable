-- Optional FPS monitor
local fpsMonitor
function ForsakenLib:EnableFPS(state)
    state = state and true or false
    if state then
        if fpsMonitor and fpsMonitor.Parent then return end
        local gui = ParentGui
        if not gui then return end
        fpsMonitor = new("ScreenGui", {Parent = gui, Name = "Forsaken_FPS", ResetOnSpawn = false})
        local lbl = makeTextLabel(fpsMonitor, {Text = "FPS: --", Size = UDim2.new(0, 80, 0, 24), Position = UDim2.new(0, 8, 0, 8), TextSize = 14})
        local last = tick()
        local count = 0
        trackConnection(RunService.RenderStepped:Connect(function(dt)
            count = count + 1
            if tick() - last >= 1 then
                lbl.Text = "FPS: "..tostring(count)
                count = 0
                last = tick()
            end
        end))
    else
        if fpsMonitor and fpsMonitor.Parent then fpsMonitor:Destroy(); fpsMonitor = nil end
    end
end

-- Theme API
function ForsakenLib:SetTheme(themeNameOrTable)
    if type(themeNameOrTable) == "string" and PRESET_THEMES[themeNameOrTable] then
        ThemeState.current = PRESET_THEMES[themeNameOrTable]
        ThemeState.name = themeNameOrTable
    elseif type(themeNameOrTable) == "table" then
        ThemeState.current = themeNameOrTable
        ThemeState.name = "Custom"
    else
        warn("[ForsakenLib] Invalid theme passed to SetTheme.")
        return
    end
    -- apply to existing windows (best-effort)
    for _, win in ipairs(_windows) do
        pcall(function()
            if win._root and win._root.Parent then
                -- recolor panels & text
                for _, obj in ipairs(win._root:GetDescendants()) do
                    if obj:IsA("Frame") and obj.BackgroundColor3 == obj.BackgroundColor3 then
                        -- naive recolor: only change backgrounds that match previous theme.Panel could be risky; keep minimal
                    end
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        pcall(function() obj.TextColor3 = ThemeState.current.Text end)
                    end
                end
            end
        end)
    end
end

-- Unload library (destroys all windows, notifications, disconnects)
function ForsakenLib:Unload()
    for _, w in ipairs(_windows) do
        pcall(function() w:Unload() end)
    end
    _windows = {}
    for _, c in ipairs(_connections) do pcall(function() c:Disconnect() end) end
    _connections = {}
    pcall(function() if NotificationsGui and NotificationsGui.Parent then NotificationsGui:Destroy() end end)
end

-- Version and expose some internals
ForsakenLib._internal = {
    getParentGui = getParentGui,
    ThemeState = ThemeState,
    PRESET_THEMES = PRESET_THEMES
}

-- finalize
return ForsakenLib