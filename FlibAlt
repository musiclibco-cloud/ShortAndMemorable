-- basic helpers
local function new(class, props)
    local inst = Instance.new(class)
    if props then
        for k,v in pairs(props) do
            if k == "Parent" then inst.Parent = v
            else
                pcall(function() inst[k] = v end)
            end
        end
    end
    return inst
end

local function tween(inst, props, info)
    if not inst then return end
    local tinfo = info or DEFAULTS.Animation.Info
    pcall(function() TweenService:Create(inst, tinfo, props):Play() end)
end

local function clamp(val, a, b) return math.max(a, math.min(b, val)) end

-- track connections for cleanup
local _connections = {}
local function trackConnection(conn)
    if conn then table.insert(_connections, conn) end
end

-- class prototypes
local function classPrototype() local p = {}; p.__index = p; return p end
