-- Helper: create topbar with drag & control buttons
local function makeTopBar(windowFrame, titleText, opts)
    local top = new("Frame", {
        Parent = windowFrame,
        Size = UDim2.new(1, 0, 0, 32),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = 50
    })
    new("UICorner", {Parent = top, CornerRadius = UDim.new(0, 8)})
    local title = makeTextLabel(top, {Text = titleText or "Forsaken Window", Size = UDim2.new(0.7, -12, 1, 0), Position = UDim2.new(0, 12, 0, 0), TextSize = 15, Font = Enum.Font.SourceSansSemibold})
    title.TextXAlignment = Enum.TextXAlignment.Left

    local btnContainer = new("Frame", {Parent = top, Size = UDim2.new(0.3, -12, 1, 0), Position = UDim2.new(1, -12, 0, 0), BackgroundTransparency = 1})
    local layout = new("UIListLayout", {Parent = btnContainer, FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8)})
    -- minimize
    local minBtn = new("ImageButton", {Parent = btnContainer, Size = UDim2.new(0, 26, 0, 20), BackgroundTransparency = 0.8, AutoButtonColor = true, Image = "", Name = "Minimize"})
    local minLbl = makeTextLabel(minBtn, {Text = "_", Size = UDim2.new(1,0,1,0), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center})
    -- close
    local closeBtn = new("ImageButton", {Parent = btnContainer, Size = UDim2.new(0, 26, 0, 20), BackgroundTransparency = 0.8, AutoButtonColor = true, Image = "", Name = "Close"})
    local closeLbl = makeTextLabel(closeBtn, {Text = "✕", Size = UDim2.new(1,0,1,0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center})

    -- basic hover tint
    local function setupButton(b)
        b.BackgroundColor3 = ThemeState.current.Panel
        b.BorderSizePixel = 0
        trackConnection(b.MouseEnter:Connect(function() tween(b, {BackgroundTransparency = 0.6}, DEFAULTS.Animation.Info) end))
        trackConnection(b.MouseLeave:Connect(function() tween(b, {BackgroundTransparency = 0.8}, DEFAULTS.Animation.Info) end))
    end
    setupButton(minBtn); setupButton(closeBtn)

    return top, minBtn, closeBtn, title
end

-- Window constructor
function ForsakenLib:CreateWindow(title, options)
    options = options or {}
    local win = setmetatable({}, WindowProto)
    win.Id = #_windows + 1
    win.Title = title or "Forsaken"
    win.Options = options
    win.Theme = options.theme and PRESET_THEMES[options.theme] and options.theme or ThemeState.name

    -- main container
    local parent = ParentGui
    if not parent then
        warn("[ForsakenLib] No valid parent GUI found for window; returning a dummy window table.")
        -- return a safe stub window (no-op)
        function win:CreateTab() return {} end
        function win:Unload() end
        return win
    end

    local screenGui = new("ScreenGui", {Parent = parent, ResetOnSpawn = false, Name = ("Forsaken_Window_%d"):format(win.Id)})
    local rootFrame = makeNeumorphicFrame(screenGui, UDim2.new(0, 760, 0, 480), UDim2.new(0.5, -380, 0.5, -240), DEFAULTS.CornerRadius)
    rootFrame.Name = "ForsakenRoot"
    rootFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    rootFrame.Position = options.position or UDim2.new(0.5, 0, 0.5, 0)

    -- topbar and control buttons
    local topBar, minBtn, closeBtn, titleLabel = makeTopBar(rootFrame, win.Title, options)
    titleLabel.Parent = topBar

    -- layout: left sidebar, content container
    local sidebar = new("Frame", {Parent = rootFrame, Size = UDim2.new(0, 180, 1, -32), Position = UDim2.new(0, 0, 0, 32), BackgroundTransparency = 1})
    local content = new("Frame", {Parent = rootFrame, Size = UDim2.new(1, -180, 1, -32), Position = UDim2.new(0, 180, 0, 32), BackgroundTransparency = 1})
    new("UIListLayout", {Parent = sidebar, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)})
    new("UIListLayout", {Parent = content, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})
    win._gui = screenGui
    win._root = rootFrame
    win._sidebar = sidebar
    win._content = content
    win._tabs = {}

    -- mobile mode toggles and drawer
    win._mobileEnabled = options.mobilemode or false
    local drawerOverlay
    local function createDrawerBehavior()
        if win._drawer and win._drawer.Parent then return end
        local drawer = new("Frame", {Parent = screenGui, Size = UDim2.new(0, 260, 1, 0), Position = UDim2.new(-1, 0, 0, 0), BackgroundColor3 = ThemeState.current.Panel, BorderSizePixel = 0, ZIndex = 1000})
        new("UICorner", {Parent = drawer, CornerRadius = DEFAULTS.CornerRadius})
        win._drawer = drawer
        -- overlay:
        drawerOverlay = new("Frame", {Parent = screenGui, BackgroundTransparency = 0.6, BackgroundColor3 = Color3.new(0,0,0), Size = UDim2.new(1,1,1,0), Position = UDim2.new(0,0,0,0), Visible = false, ZIndex = 900})
        trackConnection(drawerOverlay.InputBegan:Connect(function(input) 
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                tween(drawer, {Position = UDim2.new(-1, 0, 0, 0)}, DEFAULTS.Animation.Info)
                drawerOverlay.Visible = false
            end
        end))
    end

    -- drag logic
    local dragging = false
    local dragStart = nil
    local startPos = nil
    if options.draggable ~= false then
        trackConnection(UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                local mousePos = UserInputService:GetMouseLocation()
                local relativeGui = rootFrame.AbsolutePosition
                -- check if topbar region
                local tbAbs = topBar.AbsolutePosition
                if mousePos.Y >= tbAbs.Y and mousePos.Y <= tbAbs.Y + topBar.AbsoluteSize.Y then
                    dragging = true
                    dragStart = mousePos
                    startPos = rootFrame.Position
                end
            end
        end))
        trackConnection(UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local cur = UserInputService:GetMouseLocation()
                local delta = cur - dragStart
                local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                rootFrame.Position = newPos
            end
        end))
        trackConnection(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end))
    end

    -- minimize/close basic behavior
    trackConnection(minBtn.MouseButton1Click:Connect(function()
        -- toggle visibility of content area
        local vis = content.Visible
        content.Visible = not vis
        sidebar.Visible = not vis
    end))

    trackConnection(closeBtn.MouseButton1Click:Connect(function()
        win:Unload()
    end))

    -- mobile mode toggle API
    function win:SetMobileModeEnabled(state)
        win._mobileEnabled = state and true or false
        if win._mobileEnabled then
            createDrawerBehavior()
            -- hide sidebar, enable drawer
            sidebar.Visible = false
            win._drawer.Position = UDim2.new(-1, 0, 0, 0)
            tween(win._drawer, {Position = UDim2.new(0, 0, 0, 0)}, DEFAULTS.Animation.Info)
            if drawerOverlay then drawerOverlay.Visible = true end
        else
            if win._drawer then
                tween(win._drawer, {Position = UDim2.new(-1, 0, 0, 0)}, DEFAULTS.Animation.Info)
            end
            if drawerOverlay then drawerOverlay.Visible = false end
            sidebar.Visible = true
        end
    end

    -- auto detect small screen size for locking drawer behavior
    local function autoDetectMobile()
        local width = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X or 800
        if options.mobilemode == nil then
            if width <= 720 then
                win:SetMobileModeEnabled(true)
            else
                win:SetMobileModeEnabled(false)
            end
        else
            win:SetMobileModeEnabled(options.mobilemode)
        end
    end
    autoDetectMobile()

    -- window API implementations
    function win:CreateTab(name, icon)
        local tab = setmetatable({}, TabProto)
        tab.Name = name
        tab.Icon = icon
        tab._sections = {}
        tab._widgets = {}
        -- Sidebar button
        local btn = new("TextButton", {
            Parent = sidebar,
            Size = UDim2.new(1, -12, 0, 44),
            BackgroundColor3 = ThemeState.current.Panel,
            Text = " "..(name or "Tab"),
            TextColor3 = ThemeState.current.Text,
            Font = Enum.Font.SourceSans,
            TextSize = 14,
            AutoButtonColor = true,
            BorderSizePixel = 0
        })
        new("UICorner", {Parent = btn, CornerRadius = DEFAULTS.CornerRadius})
        -- clickable
        trackConnection(btn.MouseButton1Click:Connect(function()
            -- hide existing content children
            for _, child in ipairs(content:GetChildren()) do
                if child:IsA("Frame") then child.Visible = false end
            end
            -- show tab frame (or create)
            if not tab._frame or not tab._frame.Parent then
                local frame = new("Frame", {
                    Parent = content,
                    Size = UDim2.new(1, -12, 1, -12),
                    Position = UDim2.new(0, 6, 0, 6),
                    BackgroundTransparency = 1
                })
                tab._frame = frame
                local layout = new("UIListLayout", {Parent = frame, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})
                new("UIPadding", {Parent = frame, PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)})
                -- create sections placeholder
            end
            tab._frame.Visible = true
        end))

        -- drawer (mobile) representation
        if win._drawer then
            local dbtn = new("TextButton", {
                Parent = win._drawer,
                Size = UDim2.new(1, -12, 0, 44),
                BackgroundColor3 = ThemeState.current.Panel,
                Text = " "..(name or "Tab"),
                TextColor3 = ThemeState.current.Text,
                Font = Enum.Font.SourceSans,
                TextSize = 14,
                AutoButtonColor = true,
                BorderSizePixel = 0
            })
            new("UICorner", {Parent = dbtn, CornerRadius = DEFAULTS.CornerRadius})
            trackConnection(dbtn.MouseButton1Click:Connect(function()
                -- simulate click
                btn:CaptureFocus()
                btn.MouseButton1Click:Fire()
                if win._drawer then
                    tween(win._drawer, {Position = UDim2.new(-1, 0, 0, 0)}, DEFAULTS.Animation.Info)
                    if drawerOverlay then drawerOverlay.Visible = false end
                end
            end))
        end

        tab._button = btn
        tab._parentWindow = win
        win._tabs[#win._tabs + 1] = tab
        return tab
    end

    function win:Unload()
        -- disconnect connections
        for _, c in ipairs(_connections) do
            pcall(function() c:Disconnect() end)
        end
        _connections = {}
        -- destroy gui
        pcall(function()
            if screenGui and screenGui.Parent then
                screenGui:Destroy()
            end
        end)
        -- remove from registry
        for i, w in ipairs(_windows) do
            if w == win then table.remove(_windows, i); break end
        end
    end

    table.insert(_windows, win)
    return win
end

-- Tab methods
function TabProto:AddSection(title)
    local section = setmetatable({}, SectionProto)
    section.Title = title or ""
    section._items = {}

    -- create visual section in the tab frame if present
    if not self._frame then
        -- create frame (simulate activating the tab button)
        if self._button then
            self._button.MouseButton1Click:Fire()
        end
    end
    local parentFrame = self._frame or (self._parentWindow and self._parentWindow._content)
    if parentFrame then
        local secFrame = new("Frame", {
            Parent = parentFrame,
            Size = UDim2.new(1, 0, 0, 64),
            BackgroundColor3 = ThemeState.current.Panel,
            BorderSizePixel = 0
        })
        new("UICorner", {Parent = secFrame, CornerRadius = DEFAULTS.CornerRadius})
        local header = makeTextLabel(secFrame, {Text = title or "", Size = UDim2.new(1, -12, 0, 22), Position = UDim2.new(0, 8, 0, 6), Font = Enum.Font.SourceSansBold})
        local content = new("Frame", {Parent = secFrame, Size = UDim2.new(1, -12, 1, -34), Position = UDim2.new(0, 8, 0, 30), BackgroundTransparency = 1})
        new("UIListLayout", {Parent = content, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})
        section._frame = secFrame
        section._content = content
    else
        section._frame = nil -- stub
    end

    self._sections[#self._sections + 1] = section
    return section
end

function SectionProto:AddButton(label, callback)
    callback = callback or function() end
    local content = self._content
    if not content then
        -- fallback no-op
        return
    end
    local btn = new("TextButton", {
        Parent = content,
        Size = UDim2.new(1, 0, 0, 36),
        Text = label or "Button",
        TextSize = 14,
        Font = Enum.Font.SourceSans,
        BackgroundColor3 = ThemeState.current.Panel,
        TextColor3 = ThemeState.current.Text,
        BorderSizePixel = 0,
        AutoButtonColor = true
    })
    new("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
    trackConnection(btn.MouseButton1Click:Connect(function()
        pcall(callback, true)
        -- press animation
        local orig = btn.BackgroundTransparency
        tween(btn, {BackgroundTransparency = 0.6}, DEFAULTS.Animation.Info)
        delay(0.12, function() tween(btn, {BackgroundTransparency = orig}, DEFAULTS.Animation.Info) end)
    end))
    table.insert(self._items, btn)
    return btn
end

function SectionProto:AddToggle(label, default, callback)
    callback = callback or function() end
    default = default and true or false
    local content = self._content
    if not content then return end
    local row = new("Frame", {Parent = content, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1})
    local text = makeTextLabel(row, {Text = label or "Toggle", Size = UDim2.new(0.7, 0, 1, 0)})
    local toggle = new("ImageButton", {Parent = row, Size = UDim2.new(0, 44, 0, 24), Position = UDim2.new(1, -48, 0, 6), BackgroundTransparency = 0, AutoButtonColor = true, BorderSizePixel = 0})
    new("UICorner", {Parent = toggle, CornerRadius = UDim.new(0, 12)})
    local knob = new("Frame", {Parent = toggle, Size = UDim2.new(0.5, -4, 1, -4), Position = default and UDim2.new(0.5, 4, 0, 2) or UDim2.new(0, 2, 0, 2), BackgroundColor3 = default and ThemeState.current.Accent or Color3.fromRGB(200,200,200), BorderSizePixel = 0})
    new("UICorner", {Parent = knob, CornerRadius = UDim.new(0, 10)})
    local state = default
    trackConnection(toggle.MouseButton1Click:Connect(function()
        state = not state
        if state then
            tween(knob, {Position = UDim2.new(0.5, 4, 0, 2)}, DEFAULTS.Animation.Info)
            tween(knob, {BackgroundColor3 = ThemeState.current.Accent}, DEFAULTS.Animation.Info)
        else
            tween(knob, {Position = UDim2.new(0, 2, 0, 2)}, DEFAULTS.Animation.Info)
            tween(knob, {BackgroundColor3 = Color3.fromRGB(200,200,200)}, DEFAULTS.Animation.Info)
        end
        pcall(callback, state)
    end))
    table.insert(self._items, {type="toggle", widget=toggle})
    return toggle, function() return state end
end

