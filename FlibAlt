-- helper: create instance with properties
local function new(class, props)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k == "Parent" then
                inst.Parent = v
            else
                pcall(function() inst[k] = v end)
            end
        end
    end
    return inst
end

-- helper: tween property
local function tween(inst, props, info)
    if not inst then return end
    local tinfo = info or DEFAULTS.Animation.Info
    pcall(function()
        TweenService:Create(inst, tinfo, props):Play()
    end)
end

-- utility: round
local function clamp(val, a, b) return math.max(a, math.min(b, val)) end

-- signals tracking for Unload
local _connections = {}
local function trackConnection(conn)
    if conn then table.insert(_connections, conn) end
end

-- convenient object metatable builder
local function classPrototype(name)
    local prototype = {}
    prototype.__index = prototype
    prototype.__name = name
    return prototype
end

