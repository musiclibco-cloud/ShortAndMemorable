-- safe wrappers
local function safeEval(func, ...)
    local ok, res = pcall(func, ...)
    return ok and res or nil
end

local function safeCall(func, ...)
    local ok, err = pcall(func, ...)
    if not ok then
        warn("[ForsakenLib] safeCall error:", tostring(err))
    end
    return ok, err
end

-- executor detection (best-effort)
local ExecutorName = safeEval(function()
    if type(getexecutorname) == "function" then
        local ok, name = pcall(getexecutorname)
        if ok and name then return name end
    end
    return "Unknown"
end) or "Unknown"
ForsakenLib.Executor = ExecutorName

-- Parent selection (gethui fallback)
local function getParentGui()
    local parents = {
        function() return (type(gethui) == "function" and pcall(gethui) and gethui()) end,
        function() return (game and game:GetService and pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui")) end,
        function() local p = game.Players.LocalPlayer; if p then return p:FindFirstChild("PlayerGui") or p:WaitForChild("PlayerGui", 5) end end
    }
    for _, fn in ipairs(parents) do
        local ok, res = pcall(fn)
        if ok and res then
            return res
        end
    end
    -- fallback: create ScreenGui under PlayerGui if possible
    local ok, player = pcall(function() return game.Players.LocalPlayer end)
    if ok and player then
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            return pg
        end
    end
    warn("[ForsakenLib] Couldn't find a safe parent for UI; UI may not appear.")
    return nil
end

