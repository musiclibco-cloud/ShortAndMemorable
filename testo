            local ValueLabel = Instance.new("TextLabel")
            ValueLabel.Size = UDim2.new(1, -100, 0, 20)
            ValueLabel.Position = UDim2.new(0, 45, 1, -25)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = items[currentIndex] or "None"
            ValueLabel.TextColor3 = tetolib.Theme.Red
            ValueLabel.TextSize = 12
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.Parent = Selector
            
            local RightButton = Instance.new("TextButton")
            RightButton.Size = UDim2.new(0, 30, 0, 20)
            RightButton.Position = UDim2.new(1, -40, 1, -25)
            RightButton.BackgroundColor3 = tetolib.Theme.Red
            RightButton.Text = ">"
            RightButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            RightButton.TextSize = 14
            RightButton.Font = Enum.Font.GothamBold
            RightButton.Parent = Selector
            
            local RightCorner = Instance.new("UICorner")
            RightCorner.CornerRadius = UDim.new(0, 4)
            RightCorner.Parent = RightButton
            
            LeftButton.MouseButton1Click:Connect(function()
                currentIndex = currentIndex - 1
                if currentIndex < 1 then currentIndex = #items end
                ValueLabel.Text = items[currentIndex]
                callback(items[currentIndex])
            end)
            
            RightButton.MouseButton1Click:Connect(function()
                currentIndex = currentIndex + 1
                if currentIndex > #items then currentIndex = 1 end
                ValueLabel.Text = items[currentIndex]
                callback(items[currentIndex])
            end)
            
            return {
                Set = function(self, value)
                    for i, item in ipairs(items) do
                        if item == value then
                            currentIndex = i
                            ValueLabel.Text = item
                            break
                        end
                    end
                end
            }
        end
        
