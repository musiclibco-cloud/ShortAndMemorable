        -- Dropdown
        function Tab:CreateDropdown(options)
            local dropdownText = options.Name or "Dropdown"
            local items = options.Options or {}
            local currentOption = options.CurrentOption or items[1]
            local callback = options.Callback or function() end
            
            local Dropdown = Instance.new("Frame")
            Dropdown.Size = UDim2.new(1, 0, 0, 40)
            Dropdown.BackgroundColor3 = tetolib.Theme.ElementBackground
            Dropdown.Parent = TabContent
            Dropdown.ClipsDescendants = false
            Dropdown.ZIndex = 1
            
            local DropdownCorner = Instance.new("UICorner")
            DropdownCorner.CornerRadius = UDim.new(0, 6)
            DropdownCorner.Parent = Dropdown
            
            local DropdownStroke = Instance.new("UIStroke")
            DropdownStroke.Color = tetolib.Theme.ElementStroke
            DropdownStroke.Parent = Dropdown
            
            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -100, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = dropdownText
            Label.TextColor3 = tetolib.Theme.TextColor
            Label.TextSize = 13
            Label.Font = Enum.Font.Gotham
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.ZIndex = 1
            Label.Parent = Dropdown
            
            local SelectedLabel = Instance.new("TextLabel")
            SelectedLabel.Size = UDim2.new(0, 80, 0, 25)
            SelectedLabel.Position = UDim2.new(1, -90, 0.5, 0)
            SelectedLabel.AnchorPoint = Vector2.new(0, 0.5)
            SelectedLabel.BackgroundColor3 = tetolib.Theme.DropdownUnselected
            SelectedLabel.Text = currentOption or "None"
            SelectedLabel.TextColor3 = tetolib.Theme.TextColor
            SelectedLabel.TextSize = 11
            SelectedLabel.Font = Enum.Font.Gotham
            SelectedLabel.ZIndex = 1
            SelectedLabel.Parent = Dropdown
            
            local SelectedCorner = Instance.new("UICorner")
            SelectedCorner.CornerRadius = UDim.new(0, 4)
            SelectedCorner.Parent = SelectedLabel
            
            local DropdownList = Instance.new("Frame")
            DropdownList.Size = UDim2.new(0, 80, 0, 0)
            DropdownList.Position = UDim2.new(1, -90, 1, 5)
            DropdownList.BackgroundColor3 = tetolib.Theme.ElementBackground
            DropdownList.Visible = false
            DropdownList.ZIndex = 100
            DropdownList.Parent = Dropdown
            
            local DropdownListCorner = Instance.new("UICorner")
            DropdownListCorner.CornerRadius = UDim.new(0, 4)
            DropdownListCorner.Parent = DropdownList
            
            local DropdownListStroke = Instance.new("UIStroke")
            DropdownListStroke.Color = tetolib.Theme.Red
            DropdownListStroke.Thickness = 1
            DropdownListStroke.Parent = DropdownList
            
            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Parent = DropdownList
            
            local isOpen = false
            
            SelectedLabel.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isOpen = not isOpen
                    DropdownList.Visible = isOpen
                    if isOpen then
                        TweenService:Create(DropdownList, TweenInfo.new(0.2), {Size = UDim2.new(0, 80, 0, #items * 25)}):Play()
                    else
                        TweenService:Create(DropdownList, TweenInfo.new(0.2), {Size = UDim2.new(0, 80, 0, 0)}):Play()
                        task.wait(0.2)
                        DropdownList.Visible = false
                    end
                end
            end)
            
            for _, item in ipairs(items) do
                local ItemButton = Instance.new("TextButton")
                ItemButton.Size = UDim2.new(1, 0, 0, 25)
                ItemButton.BackgroundColor3 = tetolib.Theme.DropdownUnselected
                ItemButton.Text = item
                ItemButton.TextColor3 = tetolib.Theme.TextColor
                ItemButton.TextSize = 11
                ItemButton.Font = Enum.Font.Gotham
                ItemButton.BorderSizePixel = 0
                ItemButton.ZIndex = 100
                ItemButton.Parent = DropdownList
                
                ItemButton.MouseButton1Click:Connect(function()
                    currentOption = item
                    SelectedLabel.Text = item
                    isOpen = false
                    TweenService:Create(DropdownList, TweenInfo.new(0.2), {Size = UDim2.new(0, 80, 0, 0)}):Play()
                    task.wait(0.2)
                    DropdownList.Visible = false
                    callback(item)
                end)
                
                ItemButton.MouseEnter:Connect(function()
                    ItemButton.BackgroundColor3 = tetolib.Theme.DropdownSelected
                end)
                
                ItemButton.MouseLeave:Connect(function()
                    ItemButton.BackgroundColor3 = tetolib.Theme.DropdownUnselected
                end)
            end
            
            return {
                Set = function(self, value)
                    currentOption = value
                    SelectedLabel.Text = value
                end
            }
        end
        
